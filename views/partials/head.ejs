<% const user = locals.currentUser; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Sprint Monitor' %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #0d1117; color: #c9d1d9; min-height: 100vh;
    }
    .nav {
      background: #161b22; border-bottom: 1px solid #30363d;
      padding: 0 24px; display: flex; align-items: center; gap: 24px; height: 56px;
    }
    .nav-brand { font-weight: 700; font-size: 18px; color: #58a6ff; text-decoration: none; }
    .nav-links { display: flex; gap: 16px; }
    .nav-links a { color: #8b949e; text-decoration: none; font-size: 14px; padding: 4px 8px; border-radius: 6px; }
    .nav-links a:hover, .nav-links a.active { color: #c9d1d9; background: #21262d; }
    .nav-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
    .nav-right .user-avatar { width: 28px; height: 28px; border-radius: 50%; }
    .nav-right .user-name { font-size: 13px; color: #8b949e; }
    .nav-right .logout { color: #f85149; text-decoration: none; font-size: 13px; }
    .container { max-width: 1200px; margin: 0 auto; padding: 24px; }
    .header { margin-bottom: 24px; }
    .header h1 { font-size: 28px; color: #f0f6fc; }
    .header p { color: #8b949e; margin-top: 4px; }
    .card {
      background: #161b22; border: 1px solid #30363d; border-radius: 8px;
      padding: 20px; margin-bottom: 16px;
    }
    .card h2 { font-size: 18px; color: #f0f6fc; margin-bottom: 12px; }
    .card h3 { font-size: 15px; color: #c9d1d9; margin-bottom: 8px; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px; }
    .stat { text-align: center; padding: 12px; }
    .stat-value { font-size: 32px; font-weight: 700; }
    .stat-label { font-size: 12px; color: #8b949e; text-transform: uppercase; letter-spacing: 0.5px; }
    .grade { display: inline-block; width: 64px; height: 64px; border-radius: 50%;
      line-height: 64px; text-align: center; font-size: 28px; font-weight: 800; }
    .grade-a { background: #238636; color: #fff; }
    .grade-b { background: #1f6feb; color: #fff; }
    .grade-c { background: #d29922; color: #fff; }
    .grade-d { background: #db6d28; color: #fff; }
    .grade-f { background: #da3633; color: #fff; }
    .severity-critical { color: #f85149; font-weight: 600; }
    .severity-warning { color: #d29922; font-weight: 600; }
    .finding { padding: 8px 12px; border-left: 3px solid; margin-bottom: 8px; border-radius: 0 6px 6px 0; }
    .finding.critical { border-color: #f85149; background: rgba(248,81,73,0.1); }
    .finding.warning { border-color: #d29922; background: rgba(210,153,34,0.1); }
    .finding .sev { font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 2px; }
    .finding .msg { font-size: 14px; }
    .finding .details { font-size: 12px; color: #8b949e; margin-top: 4px; white-space: pre-wrap; }
    .table { width: 100%; border-collapse: collapse; margin-top: 12px; }
    .table th, .table td { padding: 10px 12px; text-align: left; border-bottom: 1px solid #21262d; font-size: 13px; }
    .table th { color: #8b949e; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; }
    .table tr:hover { background: #161b22; }
    .table a { color: #58a6ff; text-decoration: none; }
    .table a:hover { text-decoration: underline; }
    .btn {
      display: inline-block; padding: 8px 16px; border-radius: 6px; font-size: 14px;
      font-weight: 500; cursor: pointer; text-decoration: none; border: 1px solid #30363d;
      background: #21262d; color: #c9d1d9;
    }
    .btn:hover { background: #30363d; }
    .btn-primary { background: #238636; border-color: #238636; color: #fff; }
    .btn-primary:hover { background: #2ea043; }
    .btn-sm { padding: 4px 10px; font-size: 12px; }
    .empty { text-align: center; padding: 48px; color: #8b949e; }
    .empty h3 { color: #c9d1d9; margin-bottom: 8px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .badge-json { background: #1f6feb22; color: #58a6ff; }
    .badge-html { background: #23863622; color: #3fb950; }
    .badge-md { background: #d2992222; color: #d29922; }
    .tag-row { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
    .tag { padding: 4px 12px; border-radius: 20px; font-size: 12px; border: 1px solid #30363d; color: #8b949e; text-decoration: none; }
    .tag:hover, .tag.active { background: #21262d; color: #c9d1d9; }
    .progress-bar { height: 8px; background: #21262d; border-radius: 4px; margin-top: 8px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 4px; transition: width 0.3s ease; }
    .progress-fill.good { background: #238636; }
    .progress-fill.warn { background: #d29922; }
    .progress-fill.bad { background: #da3633; }
    .refresh-indicator { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
    .refresh-indicator .status { font-size: 13px; color: #8b949e; }
    .login-container { display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .login-card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 40px; text-align: center; max-width: 400px; width: 100%; }
    .login-card h1 { font-size: 24px; margin-bottom: 8px; }
    .login-card p { color: #8b949e; margin-bottom: 24px; }
    .google-btn {
      display: inline-flex; align-items: center; gap: 12px; padding: 12px 24px;
      background: #fff; color: #1f1f1f; border-radius: 6px; text-decoration: none;
      font-size: 15px; font-weight: 500;
    }
    .google-btn:hover { opacity: 0.9; }
    .error-msg { color: #f85149; font-size: 13px; margin-top: 16px; }
  </style>
</head>
<body>
  <nav class="nav">
    <a href="/" class="nav-brand">⚡ Sprint Monitor</a>
    <div class="nav-links">
      <a href="/" class="<%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/sprint-health" class="<%= typeof page !== 'undefined' && page === 'sprint-health' ? 'active' : '' %>">Sprint Health</a>
      <a href="/artifacts" class="<%= typeof page !== 'undefined' && page === 'artifacts' ? 'active' : '' %>">Artifacts</a>
    </div>
    <div class="nav-right">
      <% if (user && user.displayName) { %>
        <% if (user.picture) { %>
          <img src="<%= user.picture %>" class="user-avatar" alt="avatar">
        <% } %>
        <span class="user-name"><%= user.displayName %></span>
        <a href="/logout" class="logout">Sign out</a>
      <% } else { %>
        <span class="user-name" style="color:#3fb950">Dev Mode</span>
      <% } %>
    </div>
  </nav>
  <div class="container">
